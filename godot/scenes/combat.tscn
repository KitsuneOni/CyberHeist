[node name="EndTurnButton" type="Button" parent="Content/Column/Bottom/TurnBlock"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TerminalMenuButton"
theme_override_font_sizes/font_size = 26
theme_override_styles/normal = SubResource("StyleBoxFlat_action")
theme_override_styles/hover = SubResource("StyleBoxFlat_action_hover")
theme_override_styles/focus = SubResource("StyleBoxFlat_action_hover")
theme_override_styles/pressed = SubResource("StyleBoxFlat_action_pressed")
theme_override_styles/hover_pressed = SubResource("StyleBoxFlat_action_pressed")
theme_override_styles/disabled = SubResource("StyleBoxFlat_action_disabled")
text = "END TURN"

[node name="PileLabel" type="Label" parent="Content/Column/Bottom/TurnBlock"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 13
text = "draw -- · discard --"
horizontal_alignment = 1

[node name="PlayCountLabel" type="Label" parent="Content/Column/Bottom/TurnBlock"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"DimLabel"
theme_override_font_sizes/font_size = 12
horizontal_alignment = 1

[node name="CrtOverlay" type="ColorRect" parent="."]
material = SubResource("ShaderMaterial_crt")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[connection signal="security_phase" from="DrawPhase" to="Sentry" method="on_security_phase"]
[connection signal="turn_resolved" from="Sentry" to="." method="_on_sentry_turn_resolved"]
[connection signal="pressed" from="Content/Column/Bottom/TurnBlock/EndTurnButton" to="." method="_on_end_turn_button_pressed"]
[connection signal="pressed" from="Content/Column/Bottom/TurnBlock/PlayButton" to="." method="_on_play_button_pressed"]
[connection signal="pressed" from="Content/Column/Arena/ReadoutColumn/CompleteEncounterButton" to="." method="_on_complete_encounter_pressed"]
