[gd_scene load_steps=5 format=3]

[ext_resource type="Script" path="res://scenes/shop.gd" id="1_shop"]
[ext_resource type="Theme" path="res://themes/terminal_theme.tres" id="2_theme"]
[ext_resource type="Shader" path="res://shaders/crt_overlay.gdshader" id="3_crt"]

[sub_resource type="ShaderMaterial" id="ShaderMaterial_crt"]
shader = ExtResource("3_crt")

[node name="ShopScreen" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("2_theme")
script = ExtResource("1_shop")

[node name="ShopNode" type="ShopNode" parent="."]

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
color = Color(0.0392157, 0.0588235, 0.0509804, 1)

[node name="Content" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 64
theme_override_constants/margin_top = 40
theme_override_constants/margin_right = 64
theme_override_constants/margin_bottom = 32

[node name="Column" type="VBoxContainer" parent="Content"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Header" type="HBoxContainer" parent="Content/Column"]
layout_mode = 2

[node name="CreditsLabel" type="Label" parent="Content/Column/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 28
text = "$ 0  credits on hand"

[node name="TitleLabel" type="Label" parent="Content/Column/Header"]
layout_mode = 2
theme_override_font_sizes/font_size = 28
text = "DARK WEB // SHOP"
horizontal_alignment = 2

[node name="Tagline" type="Label" parent="Content/Column"]
layout_mode = 2
theme_type_variation = &"DimLabel"
text = "stock is rolled for this visit and never restocks_"

[node name="StockScroll" type="ScrollContainer" parent="Content/Column"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="StockList" type="VBoxContainer" parent="Content/Column/StockScroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="StatusLabel" type="Label" parent="Content/Column"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 28)
layout_mode = 2
theme_type_variation = &"DimLabel"

[node name="LeaveButton" type="Button" parent="Content/Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
theme_type_variation = &"TerminalMenuButton"
text = "> Leave"
alignment = 0

[node name="CrtOverlay" type="ColorRect" parent="."]
material = SubResource("ShaderMaterial_crt")
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
